<?xml version="1.0" encoding="utf-8"?>
<!-- QA test app: a TV app with a very long name and no code, to test installs, updates and removals while Home is open. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="tv.clean.qatestapp" android:versionCode="1" android:versionName="1">
    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="34" />
    <application android:label="@string/name" android:banner="@drawable/banner" android:hasCode="false">
        <activity android:name="tv.clean.qatestapp.Main" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
