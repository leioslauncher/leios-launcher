<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Home</string>

    <!-- Explicitly opaque: some firmware makes DeviceDefault translucent and the TV app keeps playing under Home.
         The window starts in the dark background colour, so there's never a white flash. -->
    <style name="Theme.Home" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/dark_bg</item>
        <item name="android:colorBackground">@color/dark_bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowSwipeToDismiss">false</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>
