<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Text on Home; colour and typeface are set in code from Theme and Tokens. -->
    <style name="HomeText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">@color/dark_text</item>
    </style>

    <style name="Pill">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">@dimen/pill_height</item>
        <item name="android:layout_marginStart">@dimen/space_3</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">@dimen/space_4</item>
        <item name="android:paddingEnd">@dimen/space_5</item>
    </style>

    <style name="PillIcon">
        <item name="android:layout_width">@dimen/icon_sm</item>
        <item name="android:layout_height">@dimen/icon_sm</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <style name="PillText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">@dimen/space_2</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/dark_text</item>
        <item name="android:textSize">@dimen/text_label</item>
    </style>
</resources>
