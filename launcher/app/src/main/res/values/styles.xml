<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="inputs">Inputs</string>
    <string name="wifi">Wi-Fi</string>
    <string name="settings">Settings</string>
    <string name="customize">Customize</string>
    <string name="search">Search</string>
    <string name="panel_label">Leios quick settings (≡ button)</string>
    <string name="panel_description">Opens the quick settings panel when you press the ≡ button on the remote, in any app. It only listens for that button, the Settings button (and the D-pad while the panel or a PIN screen is open); it does not read the screen. If you lock apps with Leios\'s PIN, it also notices which app comes to the front (its name only) to ask for the PIN.</string>
    <string name="sleep_admin">Lets the sleep timer put the projector to sleep. It can do nothing else.</string>

    <!-- Text on Home; colour and typeface are set in code from Theme and Tokens. -->
    <style name="HomeText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">@color/dark_text</item>
    </style>

    <style name="Pill">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">@dimen/pill_height</item>
        <item name="android:layout_marginStart">@dimen/space_3</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">@dimen/space_4</item>
        <item name="android:paddingEnd">@dimen/space_5</item>
    </style>

    <style name="PillIcon">
        <item name="android:layout_width">@dimen/icon_sm</item>
        <item name="android:layout_height">@dimen/icon_sm</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <style name="PillText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">@dimen/space_2</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/dark_text</item>
        <item name="android:textSize">@dimen/text_label</item>
    </style>
</resources>
