<?xml version="1.0" encoding="utf-8"?>
<!-- Home. Colours are applied in code from Theme; sizes come from dimens.xml. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_bg"
    android:clipChildren="false"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <ImageView
        android:id="@+id/wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <!-- Soft fades behind the clock and the dock, so text reads on any photo without boxes. -->
    <!-- Only as big as the fade itself: every pixel of a layer costs GPU time, even transparent ones. -->
    <View
        android:id="@+id/edgeTop"
        android:layout_width="@dimen/edge_radius"
        android:layout_height="@dimen/edge_radius"
        android:layout_gravity="top|start"
        android:visibility="gone" />

    <View
        android:id="@+id/edgeBottom"
        android:layout_width="@dimen/edge_radius"
        android:layout_height="@dimen/edge_radius"
        android:layout_gravity="bottom|start"
        android:visibility="gone" />

    <!-- Fades in over the background while the app grid is open, so tiles and names stand out. -->
    <View
        android:id="@+id/gridScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:visibility="invisible" />

    <ScrollView
        android:id="@+id/scroller"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:descendantFocusability="blocksDescendants"
        android:focusable="false"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/hero"
                android:layout_width="match_parent"
                android:layout_height="@dimen/hero_height"
                android:clipChildren="false">

                <View
                    android:id="@+id/glow"
                    android:layout_width="@dimen/glow_size"
                    android:layout_height="@dimen/glow_size"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="@dimen/glow_offset_x"
                    android:layout_marginBottom="@dimen/glow_offset_y" />

                <LinearLayout
                    android:id="@+id/topBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/safe_v"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/safe_h"
                    android:paddingEnd="@dimen/safe_h">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/greeting"
                            style="@style/HomeText"
                            android:letterSpacing="0.04"
                            android:textSize="@dimen/text_label" />

                        <TextView
                            android:id="@+id/clock"
                            style="@style/HomeText"
                            android:layout_marginTop="@dimen/space_1"
                            android:fontFeatureSettings="tnum"
                            android:includeFontPadding="false"
                            android:textSize="@dimen/text_display" />

                        <TextView
                            android:id="@+id/date"
                            style="@style/HomeText"
                            android:layout_marginTop="@dimen/space_2"
                            android:textSize="@dimen/text_body" />

                        <TextView
                            android:id="@+id/weather"
                            style="@style/HomeText"
                            android:layout_marginTop="@dimen/space_2"
                            android:textSize="@dimen/text_body"
                            android:visibility="gone" />
                    </LinearLayout>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <LinearLayout
                        android:id="@+id/pillRow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clipChildren="false"
                        android:orientation="horizontal">

                        <!-- Notifications (Customize › Look › Top bar); only while there are some. -->
                        <LinearLayout
                            android:id="@+id/pillNotif"
                            style="@style/Pill"
                            android:layout_marginStart="0dp"
                            android:layout_marginEnd="@dimen/space_3"
                            android:visibility="gone">

                            <ImageView
                                style="@style/PillIcon"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_bell" />

                            <TextView
                                android:id="@+id/notifLabel"
                                style="@style/PillText" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/pillInputs"
                            style="@style/Pill"
                            android:layout_marginStart="0dp">

                            <ImageView
                                style="@style/PillIcon"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_input" />

                            <TextView
                                style="@style/PillText"
                                android:text="@string/inputs" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/pillWifi"
                            style="@style/Pill">

                            <ImageView
                                android:id="@+id/wifiIcon"
                                style="@style/PillIcon"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_wifi" />

                            <TextView
                                android:id="@+id/wifiLabel"
                                style="@style/PillText"
                                android:maxWidth="@dimen/pill_label_max"
                                android:text="@string/wifi" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/pillCustomize"
                            style="@style/Pill">

                            <ImageView
                                style="@style/PillIcon"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_palette" />

                            <TextView
                                style="@style/PillText"
                                android:text="@string/customize" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/pillSettings"
                            style="@style/Pill">

                            <ImageView
                                style="@style/PillIcon"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_settings" />

                            <TextView
                                style="@style/PillText"
                                android:text="@string/settings" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/dockTitle"
                    style="@style/HomeText"
                    android:layout_gravity="bottom|start"
                    android:layout_marginBottom="@dimen/space_4"
                    android:textSize="@dimen/text_title" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/dockBand"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/safe_h"
                android:layout_marginEnd="@dimen/safe_h"
                android:layout_marginBottom="@dimen/safe_v"
                android:clipChildren="false"
                android:paddingStart="@dimen/space_4"
                android:paddingTop="@dimen/space_2"
                android:paddingEnd="@dimen/space_4"
                android:paddingBottom="@dimen/space_1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/dockList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:overScrollMode="never" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/gridSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:orientation="vertical"
                android:paddingStart="@dimen/grid_inset"
                android:paddingTop="@dimen/space_2"
                android:paddingEnd="@dimen/grid_inset"
                android:paddingBottom="@dimen/space_7">
                <!-- One header and one list per category, added in code. -->
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Shown while a tile is picked up: which buttons move it. Filled in code. -->
    <LinearLayout
        android:id="@+id/moveHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_5"
        android:paddingTop="@dimen/space_3"
        android:paddingEnd="@dimen/space_5"
        android:paddingBottom="@dimen/space_3"
        android:visibility="gone" />

    <tv.leios.launcher.HighlightView
        android:id="@+id/highlight"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
