<?xml version="1.0" encoding="utf-8"?>
<!-- One app tile; size, corners and colours are set by TileAdapter from Tokens and Theme. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="@dimen/space_2"
    android:paddingBottom="@dimen/space_1">

    <FrameLayout
        android:id="@+id/card"
        android:layout_width="148dp"
        android:layout_height="83dp">

        <ImageView
            android:id="@+id/banner"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <!-- Fallback tile: the app's name under its icon when it has no banner. -->
        <TextView
            android:id="@+id/fallbackName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginBottom="@dimen/space_2"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="@dimen/space_2"
            android:paddingEnd="@dimen/space_2"
            android:textSize="@dimen/text_caption"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/label"
        android:layout_width="148dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2"
        android:alpha="0"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textSize="@dimen/text_caption" />
</LinearLayout>
