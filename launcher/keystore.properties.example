# Copy to keystore.properties (never commit it) to sign release builds.
# Or set the same four values as environment variables:
# LEIOS_STORE_FILE, LEIOS_STORE_PASSWORD, LEIOS_KEY_ALIAS, LEIOS_KEY_PASSWORD
storeFile=C:/path/outside/the/repo/example-release.keystore
storePassword=example-store-password
keyAlias=example-alias
keyPassword=example-key-password